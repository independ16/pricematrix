# Copy this file to .env and fill in your values
# NEVER commit .env to git — it contains secrets

# Full JSON contents of your Google service account key file
# Paste the entire JSON on one line, or use the file path approach below
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Google Sheet ID — the long string between /d/ and /edit in the sheet URL
GOOGLE_SPREADSHEET_ID=12L-DSPUcCDbzf1i6ysHLZaJ1WtwDEM9WPF9voHAE3_U

# Exact tab name in the Google Sheet (case-sensitive)
GOOGLE_SHEET_TAB=pricing_data
